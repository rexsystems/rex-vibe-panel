DATABASE_URL=postgres://rex:rex@localhost:5432/rex
APP_ORIGIN=http://localhost:5173
PORT=3000
HOST=0.0.0.0
COOKIE_SECURE=false
POSTGRES_PASSWORD=
REX_DATA_DIR=/var/lib/rex
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Public repository shown in the footer. Source archive remains available via API.
SOURCE_URL=https://github.com/rexsystems/rex-vibe-panel
REGISTRATION_ENABLED=true
API_RATE_LIMIT=1200
# Optional: import a private default provider for the first administrator only.
DEFAULT_AI_PROVIDER=
BEDROCK_MANTLE_REGION=us-east-1
BEDROCK_MANTLE_MODEL=qwen.qwen3-coder-next
BEDROCK_MANTLE_API_KEY=
AGENT_PANEL_URL=ws://localhost:3000/api/v1/agent/connect
AGENT_ENROLLMENT_TOKEN=
AGENT_DATA_DIR=./data/agent
AGENT_HOST_DATA_DIR=
DOCKER_SOCKET=/var/run/docker.sock
# Optional overrides for automatic local-node enrollment.
LOCAL_AGENT_IMAGE=
LOCAL_AGENT_PANEL_URL=
