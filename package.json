{
  "name": "rex-vibe-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/rexsystems/rex-vibe-panel.git"
  },
  "homepage": "https://github.com/rexsystems/rex-vibe-panel#readme",
  "bugs": {
    "url": "https://github.com/rexsystems/rex-vibe-panel/issues"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/linux-x64",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "concurrently -k -n api,web,worker \"tsx watch apps/api/index.ts\" \"vite --host 0.0.0.0\" \"tsx watch apps/worker/index.ts\"",
    "dev:agent": "tsx watch apps/agent/index.ts",
    "build": "tsc -p tsconfig.server.json && node scripts/copy-assets.mjs && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "node dist/server/apps/api/index.js",
    "worker": "node dist/server/apps/worker/index.js",
    "agent": "node dist/server/apps/agent/index.js",
    "db:migrate": "tsx packages/db/migrate.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1000.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/websocket": "^11.2.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@mantine/core": "^8.3.0",
    "@mantine/form": "^8.3.0",
    "@mantine/hooks": "^8.3.0",
    "@mantine/notifications": "^8.3.0",
    "@tanstack/react-query": "^5.90.0",
    "dockerode": "^5.0.1",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.7.0",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "tar-stream": "^3.1.7",
    "ws": "^8.19.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.58.0",
    "@types/dockerode": "^3.3.46",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/tar-stream": "^3.1.4",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "embedded-postgres": "18.4.0-beta.17",
    "postcss": "^8.5.0",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
